<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cake Build System -->
    <PackageVersion Include="Cake.FileHelpers" Version="4.0.1" />
    <PackageVersion Include="Cake.Frosting" Version="1.3.0" />
    <PackageVersion Include="Cake.Testing" Version="1.3.0" />
    <!-- Database -->
    <PackageVersion Include="dbup" Version="4.5.0" />
    <!-- Testing -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.0" />
  </ItemGroup>
</Project>