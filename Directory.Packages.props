<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cake Build System -->
    <PackageVersion Include="Cake.FileHelpers" Version="7.0.0" />
    <PackageVersion Include="Cake.Frosting" Version="6.0.0" />
    <PackageVersion Include="Cake.Testing" Version="6.0.0" />
    <!-- Database -->
    <PackageVersion Include="DbUp.Reboot.SqlServer" Version="1.8.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <!-- Testing -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.0" />
  </ItemGroup>
</Project>